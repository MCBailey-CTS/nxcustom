!
!  NX CTS Custom ribbon tab
!
!

TITLE  Merlin
VERSION 170

BEGIN_GROUP FULL_HITS
    LABEL Full Hits

    BUTTON AUTO_DESIGN
        LABEL Auto Design
        RIBBON_STYLE SMALL_IMAGE_AND_TEXT
        BITMAP ${NXCUSTOM_LIB}\toolbars\bitmaps\SimulationDataBuilder.bmp
        ACTION ${NXCUSTOM_LIB}\ufunc\python\AutoDesign.py

    BUTTON GM_BLANK_STATION
        LABEL Blank Station
        RIBBON_STYLE SMALL_IMAGE_AND_TEXT
        BITMAP ${NXCUSTOM_LIB}\toolbars\bitmaps\SimulationDataBuilder.bmp
        ACTION ${NXCUSTOM_LIB}\ufunc\gm-blank-station.dll

    BUTTON GM_SECONDARY_TRIM_STATION
        LABEL Secondary Trim Station
        RIBBON_STYLE SMALL_IMAGE_AND_TEXT
        BITMAP ${NXCUSTOM_LIB}\toolbars\bitmaps\SimulationDataBuilder.bmp
        ACTION ${NXCUSTOM_LIB}\ufunc\gm-secondary-trim-station.dll

    BUTTON DRAW_DIE
        LABEL Draw Die
        RIBBON_STYLE SMALL_IMAGE_AND_TEXT
        BITMAP ${NXCUSTOM_LIB}\toolbars\bitmaps\SimulationDataBuilder.bmp
        ACTION ${NXCUSTOM_LIB}\ufunc\draw-die-creator.dll("UFUNC", "DrawDieCreator")

    BUTTON FLANGE_HIT
        LABEL Flange Hit
        RIBBON_STYLE SMALL_IMAGE_AND_TEXT
        BITMAP ${NXCUSTOM_LIB}\toolbars\bitmaps\SimulationDataBuilder.bmp
        ACTION ${NXCUSTOM_LIB}\ufunc\flange-hit.dll

    BUTTON DEAD_HIT
        LABEL Dead Hit
        RIBBON_STYLE SMALL_IMAGE_AND_TEXT
        BITMAP ${NXCUSTOM_LIB}\toolbars\bitmaps\SimulationDataBuilder.bmp
        ACTION ${NXCUSTOM_LIB}\ufunc\python\DeadStrike.py

    BUTTON RESTRIKE
        LABEL Restrike
        RIBBON_STYLE SMALL_IMAGE_AND_TEXT
        BITMAP ${NXCUSTOM_LIB}\toolbars\bitmaps\SimulationDataBuilder.bmp
        ACTION ${NXCUSTOM_LIB}\ufunc\python\GmCastPost.py

    BUTTON PIERCE
        LABEL Pierce
        RIBBON_STYLE SMALL_IMAGE_AND_TEXT
        BITMAP ${NXCUSTOM_LIB}\toolbars\bitmaps\SimulationDataBuilder.bmp
        ACTION ${NXCUSTOM_LIB}\ufunc\gm-pierce.dll

    BUTTON GM_SPLIT_FORM
        LABEL GM Split Form
        RIBBON_STYLE SMALL_IMAGE_AND_TEXT
        BITMAP ${NXCUSTOM_LIB}\toolbars\bitmaps\SimulationDataBuilder.bmp
        ACTION ${NXCUSTOM_LIB}\ufunc\python\GmSplitForm.py

END_GROUP

