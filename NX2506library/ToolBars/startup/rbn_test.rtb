        BITMAP ${NXCUSTOM_LIB}\toolbars\bitmaps\cts_logo.bmp
        ACTION ${NXCUSTOM_LIB}\ufunc\NXRemotingServer.dll

    BUTTON TestGmSplitForm
        LABEL gm-split-form
        RIBBON_STYLE SMALL_IMAGE_AND_TEXT
