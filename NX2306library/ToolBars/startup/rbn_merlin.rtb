TITLE  Merlin
VERSION 170

BEGIN_GROUP MERLIN_0
    LABEL MERLIN-0
    
    BUTTON GM_COMPONENT
        LABEL GM Component
        RIBBON_STYLE SMALL_IMAGE_AND_TEXT
        BITMAP ${NXCUSTOM_LIB}\toolbars\bitmaps\SimulationDataBuilder.bmp
        ACTION G:\CTS\junk\merlin\gm-component.dll

    

    BUTTON GM_SPLIT_FORM
        LABEL GM Split Form
